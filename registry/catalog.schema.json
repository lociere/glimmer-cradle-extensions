{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Glimmer Cradle Extension Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extensions"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "publisher", "repository", "manifest_path", "latest_version", "channels"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "format": "uri" },
          "manifest_path": { "type": "string", "minLength": 1 },
          "latest_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
          "channels": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
