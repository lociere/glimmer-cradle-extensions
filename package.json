{
  "name": "glimmer-cradle-extensions",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "link:local-sdk": "node scripts/link-local-sdk.mjs",
    "validate:extensions": "node scripts/validate-workspace.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "validate": "pnpm validate:extensions && pnpm validate:registry && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@glimmer-cradle/protocol": "^0.1.0"
  },
  "devDependencies": {
    "yaml": "^2.8.1",
    "zod": "^3.23.0"
  }
}
